# ===========================================
# Vibe SaaS Starter Kit - Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values

# Application
NEXT_PUBLIC_APP_NAME="Vibe SaaS"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ===========================================
# Database (PostgreSQL)
# ===========================================
# For local development with Docker:
# docker run --name postgres -e POSTGRES_PASSWORD=password -e POSTGRES_DB=vibe_saas -p 5432:5432 -d postgres
DATABASE_URL="postgresql://postgres:password@localhost:5432/vibe_saas?schema=public"

# ===========================================
# Authentication (NextAuth.js)
# ===========================================
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-auth-secret-here"

# Google OAuth (optional)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# GitHub OAuth (optional)
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# ===========================================
# Stripe Billing
# ===========================================
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""

# Webhook secret from: stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=""

# Price IDs for your subscription plans
STRIPE_PRICE_ID_STARTER=""
STRIPE_PRICE_ID_PRO=""
STRIPE_PRICE_ID_ENTERPRISE=""

# ===========================================
# Email (Resend)
# ===========================================
# Get from: https://resend.com/api-keys
RESEND_API_KEY=""
EMAIL_FROM="noreply@yourdomain.com"

# ===========================================
# AI / OpenAI
# ===========================================
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=""

# ===========================================
# Analytics (optional)
# ===========================================
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"
