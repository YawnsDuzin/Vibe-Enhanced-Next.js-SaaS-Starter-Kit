# ===========================================
# Vibe SaaS Starter Kit - 환경 변수
# ===========================================
# 이 파일을 .env.local로 복사하고 값을 입력하세요

# Application
NEXT_PUBLIC_APP_NAME="Vibe SaaS"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ===========================================
# Supabase
# ===========================================
# Supabase 대시보드에서 확인: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ===========================================
# Stripe 결제
# ===========================================
# https://dashboard.stripe.com/apikeys 에서 확인
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""

# 웹훅 시크릿: stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=""

# 구독 플랜의 Price ID
STRIPE_PRICE_ID_STARTER=""
STRIPE_PRICE_ID_PRO=""
STRIPE_PRICE_ID_ENTERPRISE=""

# ===========================================
# 이메일 (Resend)
# ===========================================
# https://resend.com/api-keys 에서 확인
RESEND_API_KEY=""
EMAIL_FROM="noreply@yourdomain.com"

# ===========================================
# AI / OpenAI
# ===========================================
# https://platform.openai.com/api-keys 에서 확인
OPENAI_API_KEY=""

# ===========================================
# 분석 (선택)
# ===========================================
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"
