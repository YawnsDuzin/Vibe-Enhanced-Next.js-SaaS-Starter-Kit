# ===========================================
# Vibe SaaS Starter Kit - 환경 변수
# ===========================================
# 이 파일을 .env.local로 복사하고 값을 입력하세요

# Application
NEXT_PUBLIC_APP_NAME="Vibe SaaS"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ===========================================
# Supabase
# ===========================================
# Supabase 대시보드에서 확인: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ===========================================
# OAuth 인증 (소셜 로그인)
# ===========================================
# Google, Kakao: Supabase 대시보드 → Authentication → Providers 에서 설정
# 각 제공자의 개발자 콘솔에서 Client ID/Secret 발급 필요

# ===========================================
# Stripe 결제 (해외 결제용)
# ===========================================
# https://dashboard.stripe.com/apikeys 에서 확인
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""

# 웹훅 시크릿: stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=""

# 구독 플랜의 Price ID
STRIPE_PRICE_ID_STARTER=""
STRIPE_PRICE_ID_PRO=""
STRIPE_PRICE_ID_ENTERPRISE=""

# ===========================================
# 토스페이먼츠 (한국 결제용)
# ===========================================
# https://developers.tosspayments.com 에서 확인
# 테스트 키는 test_로 시작, 라이브 키는 live_로 시작
TOSS_CLIENT_KEY=""
TOSS_SECRET_KEY=""

# 웹훅 시크릿: 토스페이먼츠 개발자센터에서 웹훅 등록 후 확인
TOSS_WEBHOOK_SECRET=""

# 구독 플랜 ID (선택 - 자동 정기결제 사용 시)
TOSS_PRICE_ID_STARTER="starter_monthly"
TOSS_PRICE_ID_PRO="pro_monthly"
TOSS_PRICE_ID_ENTERPRISE="enterprise_monthly"

# ===========================================
# 이메일 (Resend)
# ===========================================
# https://resend.com/api-keys 에서 확인
RESEND_API_KEY=""
EMAIL_FROM="noreply@yourdomain.com"

# ===========================================
# AI / OpenAI
# ===========================================
# https://platform.openai.com/api-keys 에서 확인
OPENAI_API_KEY=""

# ===========================================
# 분석 (선택)
# ===========================================
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"
